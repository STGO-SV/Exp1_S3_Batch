# Plantilla sin secretos reales. Genere/reutilice .env con: pwsh ./scripts/initialize-compose-environment.ps1
# El script es idempotente; use -RotateSecrets únicamente para una rotación deliberada.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
OAUTH_WEB_CLIENT_SECRET=replace-with-16-to-72-bytes
OAUTH_MOBILE_CLIENT_SECRET=replace-with-16-to-72-bytes
OAUTH_ATM_CLIENT_SECRET=replace-with-16-to-72-bytes
JWT_PRIVATE_KEY=replace-with-pkcs8-base64
JWT_PUBLIC_KEY=replace-with-x509-base64
TLS_KEYSTORE_PASSWORD=replace-with-local-keystore-password
BATCH_DATA_DIR=../bank_legacy_data/data/semana_3
