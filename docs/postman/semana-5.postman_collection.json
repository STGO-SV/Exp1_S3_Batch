{
  "info": {
    "name": "Banco Legacy — Semana 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo HTTPS local directa. Añadir contraseñas sólo como valores locales secretos; no exportar el entorno. Modo rápido: SSL verification OFF demuestra TLS pero no confianza. Evidencia estricta: importar/confiar el certificado local y mantener SSL verification ON."
  },
  "item": [
    {
      "name": "Token WEB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"web-user\",\n  \"password\": \"{{web_password}}\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/auth/token",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"web_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
